# The package is made for sysvinit systems (Devuan); one init script runs
# all configured standalone wiki servers. On systemd systems the init
# script is used through the SysV generator, a sample unit is in examples/.
python3-moinmoin: missing-systemd-service-for-init.d-script moinmoin [etc/init.d/moinmoin]
# The Java drawing applets and FCKeditor are static files served by the
# wiki from the MoinMoin package directory.
python3-moinmoin: jar-not-in-usr-share [usr/lib/python3/dist-packages/MoinMoin/web/static/htdocs/applets/*]
python3-moinmoin: embedded-javascript-library please use fckeditor [usr/lib/python3/dist-packages/MoinMoin/web/static/htdocs/applets/FCKeditor/fckeditor.js]
